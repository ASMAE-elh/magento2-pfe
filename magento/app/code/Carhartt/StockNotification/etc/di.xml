<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <preference for="Carhartt\StockNotification\Api\Data\NotificationInterface"
            type="Carhartt\StockNotification\Model\Notification"/>

    <preference for="Carhartt\StockNotification\Api\NotificationRepositoryInterface"
                type="Carhartt\StockNotification\Model\NotificationRepository"/>

    <!-- Add Customer Logger -->
    <virtualType name="Carhartt\StockNotification\Logger\VirtualCustomHandler"
                 type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/carhartt-stocknotification.log</argument>
        </arguments>
    </virtualType>

    <virtualType name="Carhartt\StockNotification\Logger\VirtualCustomLogger" type="Monolog\Logger">
        <arguments>
            <argument name="name" xsi:type="string">Carhartt_StockNotification</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">Carhartt\StockNotification\Logger\VirtualCustomHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- Use custom logger -->
    <type name="Carhartt\StockNotification\Controller\Ajax\Submit">
        <arguments>
            <argument name="logger" xsi:type="object">Carhartt\StockNotification\Logger\VirtualCustomLogger</argument>
        </arguments>
    </type>
    <type name="Carhartt\StockNotification\Helper\Data">
        <arguments>
            <argument name="logger" xsi:type="object">Carhartt\StockNotification\Logger\VirtualCustomLogger</argument>
        </arguments>
    </type>
    <type name="Carhartt\StockNotification\Helper\Data">
        <arguments>
            <argument name="limit" xsi:type="number">100</argument>
        </arguments>
    </type>
</config>
