<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="monmodule" translate="label" type="text" sortOrder="100" showInDefault="1">
            <label>Mon Module</label>
            <tab>general</tab>
            <resource>MonEntreprise_MonModule::config</resource>
            <group id="googlemaps" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>Google Maps</label>
                <field id="map_url" translate="label" type="textarea" sortOrder="10" showInDefault="1">
                    <label>URL de la carte</label>
                    <comment>Colle ici l'URL iframe de Google Maps</comment>
                </field>
            </group>
        </section>
    </system>
</config>
