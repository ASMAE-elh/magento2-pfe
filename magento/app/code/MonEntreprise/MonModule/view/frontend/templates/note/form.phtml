<?php /** @var \MonEntreprise\MonModule\Block\Note\Form $block */ ?>
<?php $note = $block->getNote(); ?>

<div style="padding: 30px;">
    <h1><?= $note->getNoteId() ? 'Modifier la Note' : 'Nouvelle Note' ?></h1>

    <form action="<?= $block->getUrl('monmodule/note/save') ?>" method="post">
        <?= $block->getBlockHtml('formkey') ?>

        <input type="hidden" name="note_id" value="<?= (int) $note->getNoteId() ?>"/>

        <div style="margin-bottom:15px;">
            <label style="display:block;margin-bottom:5px;">Titre :</label>
            <input type="text" name="title"
                   value="<?= $block->escapeHtmlAttr($note->getTitle()) ?>"
                   style="width:100%;padding:8px;border:1px solid #ddd;"
                   required/>
        </div>

        <div style="margin-bottom:15px;">
            <label style="display:block;margin-bottom:5px;">Contenu :</label>
            <textarea name="content" rows="5"
                      style="width:100%;padding:8px;border:1px solid #ddd;"><?= $block->escapeHtml($note->getContent()) ?></textarea>
        </div>

        <button type="submit"
                style="background:#e07b39;color:white;padding:10px 20px;border:none;border-radius:4px;cursor:pointer;">
            Sauvegarder
        </button>

        <a href="<?= $block->getUrl('monmodule/note/index') ?>"
           style="margin-left:10px;">Annuler</a>
    </form>
</div>
