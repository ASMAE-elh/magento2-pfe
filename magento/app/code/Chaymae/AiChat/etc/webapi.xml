<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/chaymae-aichat/chat" method="POST">
        <service class="Chaymae\AiChat\Api\ChatServiceInterface" method="sendMessage"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
    <route url="/V1/chaymae-aichat/vision" method="POST">
        <service class="Chaymae\AiChat\Api\ChatServiceInterface" method="sendImage"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
