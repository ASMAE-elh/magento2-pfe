<script>
    function chaymaeAiChat() {
        return {
            open: false,
            loading: false,
            input: '',
            messages: [],
            products: [],

            async send() {
                const text = this.input.trim();
                if (!text || this.loading) {
                    return;
                }

                this.messages.push({ role: 'user', text });
                this.input = '';
                this.loading = true;
                this.products = [];
                this.scrollToBottom();

                try {
                    const response = await fetch('/rest/V1/chaymae-aichat/chat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ message: text })
                    });

                    if (!response.ok) {
                        throw new Error('Request failed');
                    }

                    const rawString = await response.json();
                    const data = JSON.parse(rawString);

                    this.messages.push({ role: 'assistant', text: data.reply || '' });
                    this.products = data.products || [];
                } catch (e) {
                    this.messages.push({
                        role: 'assistant',
                        text: "Desole, une erreur est survenue. Merci de reessayer."
                    });
                } finally {
                    this.loading = false;
                    this.scrollToBottom();
                }
            },

            async onImageSelected(event) {
                const file = event.target.files[0];
                if (!file || this.loading) {
                    return;
                }

                // Affiche un apercu de la photo envoyee dans la conversation
                const previewUrl = URL.createObjectURL(file);
                this.messages.push({ role: 'user', image: previewUrl });
                this.loading = true;
                this.products = [];
                this.scrollToBottom();

                try {
                    const base64 = await this.fileToBase64(file);

                    const response = await fetch('/rest/V1/chaymae-aichat/vision', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            imageBase64: base64,
                            mimeType: file.type || 'image/jpeg'
                        })
                    });

                    if (!response.ok) {
                        throw new Error('Request failed');
                    }

                    const rawString = await response.json();
                    const data = JSON.parse(rawString);

                    this.messages.push({ role: 'assistant', text: data.reply || '' });
                    this.products = data.products || [];
                } catch (e) {
                    this.messages.push({
                        role: 'assistant',
                        text: "Desole, je n'ai pas pu analyser cette photo. Merci de reessayer."
                    });
                } finally {
                    this.loading = false;
                    event.target.value = '';
                    this.scrollToBottom();
                }
            },

            fileToBase64(file) {
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onload = () => {
                        // reader.result est de la forme "data:image/jpeg;base64,XXXXX"
                        // on ne garde que la partie apres la virgule
                        const base64 = reader.result.split(',')[1];
                        resolve(base64);
                    };
                    reader.onerror = reject;
                    reader.readAsDataURL(file);
                });
            },

            scrollToBottom() {
                this.$nextTick(() => {
                    const el = this.$refs.scrollArea;
                    if (el) {
                        el.scrollTop = el.scrollHeight;
                    }
                });
            }
        };
    }
</script>
