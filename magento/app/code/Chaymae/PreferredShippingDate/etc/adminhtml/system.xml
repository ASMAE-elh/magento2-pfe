<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="shipping" translate="label" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <group id="preferred_date" translate="label" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Preferred Shipping Date</label>
                <field id="min_days" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Days from Today</label>
                    <comment>Minimum number of days the customer must wait before choosing a delivery date.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
