$items = $block->getItems();
$subtotal = $block->getSubtotal();
?>
<div x-data="{
    loading: false,
    shippingMethods: [],
    form: {
        email: '',
        firstname: '',
        lastname: '',
        telephone: '',
        street: '',
        city: '',
        postcode: '',
        country_id: 'MA',
        shipping_method: '',
        payment_method: 'checkmo'
    },
    errors: {},
    subtotal: <?= (float)$subtotal ?>,
    shippingCost: 0,
    get grandTotal() {
        return (this.subtotal + this.shippingCost).toFixed(2);
    },
    async loadShippingMethods() {
        const res = await fetch('/chaymae_osc/ajax/shippingmethods', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({
                country_id: this.form.country_id,
                postcode: this.form.postcode,
                city: this.form.city
            })
        });
        const data = await res.json();
        if (data.success && data.methods.length > 0) {
            this.shippingMethods = data.methods;
            this.form.shipping_method = data.methods[0].carrier_code + '_' + data.methods[0].method_code;
            this.shippingCost = parseFloat(data.methods[0].amount);
        }
    },
    selectShipping(method) {
        this.form.shipping_method = method.carrier_code + '_' + method.method_code;
        this.shippingCost = parseFloat(method.amount);
    },
    validate() {
        this.errors = {};
        if (!this.form.email) this.errors.email = true;
        if (!this.form.firstname) this.errors.firstname = true;
        if (!this.form.lastname) this.errors.lastname = true;
        if (!this.form.street) this.errors.street = true;
        if (!this.form.city) this.errors.city = true;
        if (!this.form.postcode) this.errors.postcode = true;
        if (!this.form.shipping_method) this.errors.shipping = true;
        return Object.keys(this.errors).length === 0;
    },
    async placeOrder() {
        if (!this.validate()) return;
        this.loading = true;
        try {
            const res = await fetch('/chaymae_osc/ajax/placeorder', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify(this.form)
            });
            const data = await res.json();
            if (data.success) {
                window.location.href = data.redirect;
            } else {
                alert('Erreur: ' + data.message);
                this.loading = false;
            }
        } catch(e) {
            alert('Erreur: ' + e.message);
            this.loading = false;
        }
    }
}" x-init="loadShippingMethods()">

